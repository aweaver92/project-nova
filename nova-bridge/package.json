{
  "name": "nova-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nova Bridge: a small local service that lets the Nova iOS app run Claude Code and drive Cursor agents on your dev machine.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "service:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-bridge-service.ps1",
    "service:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-bridge-service.ps1",
    "service:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-bridge.ps1",
    "service:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-bridge.ps1",
    "typecheck": "tsc --noEmit",
    "test:stream": "tsx src/cursor-stream.test.ts",
    "test:repos": "tsx src/repo-service.test.ts",
    "test:preview": "tsx src/preview-service.test.ts",
    "test:baseline": "tsx src/baseline-service.test.ts",
    "test": "npm run test:stream && npm run test:repos && npm run test:preview && npm run test:baseline"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.23",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "optionalDependencies": {
    "@cursor/sdk-win32-x64": "^1.0.23"
  }
}
