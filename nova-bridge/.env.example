# Copy to .env and fill in. The bridge reads these at startup.

# Port the bridge listens on (default 8787).
PORT=8787

# LAN bind address. Keep 0.0.0.0 for iPhone auto-discovery/reachability.
HOST=0.0.0.0

# Shared secret. MUST match the "Bridge token" you enter in the Nova app
# (Settings -> Bridge). Use a long random string.
NOVA_BRIDGE_TOKEN=change-me-to-a-long-random-secret

# Cursor SDK API key (user key or team service-account key).
# From https://cursor.com/dashboard/integrations
CURSOR_API_KEY=cursor_...

# OpenAI API key used ONLY server-side to mint short-lived Realtime client
# secrets for the app (POST /realtime/token). This key never ships in the .ipa;
# the app fetches a fresh ephemeral secret from the bridge each session.
OPENAI_API_KEY=

# Realtime model for the minted secrets. Must match the app's Realtime model.
OPENAI_REALTIME_MODEL=gpt-realtime

# Default model for Cursor agents (see `Cursor.models.list()`).
CURSOR_MODEL=composer-2.5

# Default working directory for Claude Code / Cursor agents when the request
# doesn't specify a repoId. Defaults to the directory you start the bridge from.
NOVA_BRIDGE_WORKDIR=

# Semicolon-separated allowlisted roots for phone repository discovery/clone.
# Defaults to the parent of NOVA_BRIDGE_WORKDIR when that folder is itself a
# git repo (so sibling clones are listed). Discovery only scans the root and
# its immediate children that already contain .git — it will not deep-walk
# Dropbox trees (that previously hung the bridge and timed out the phone).
# Example (Windows): NOVA_REPO_ROOTS=C:\Users\you\src;D:\work
NOVA_REPO_ROOTS=

# Optional absolute paths to git / GitHub CLI. Leave unset to auto-detect.
# GIT_BIN=C:\Program Files\Git\cmd\git.exe
# GH_BIN=C:\Program Files\GitHub CLI\gh.exe

# Optional absolute path to rg.exe. On Windows ARM the SDK has no native
# platform package; leave unset to auto-detect Cursor's bundled ripgrep.
# CURSOR_RIPGREP_PATH=C:\Users\you\AppData\Local\Programs\cursor\resources\app\node_modules\@vscode\ripgrep\bin\rg.exe

# Live preview ports for "Preview in browser" (phone Safari on your LAN).
# The bridge serves static projects itself and runs `npm run dev` for
# vite/next projects, bound to 0.0.0.0. These ports are unauthenticated —
# they only serve project files/dev servers, never bridge APIs.
# NOVA_PREVIEW_PORT_BASE=8790
# NOVA_PREVIEW_PORT_COUNT=10
#
# Optional Tailscale CGNAT IPv4 used for remote Safari previews when the phone
# reaches the bridge via https://….ts.net (auto-detected via `tailscale ip -4`
# when unset). Peer-to-peer on the tailnet — no Serve mapping needed for 8790+.
# NOVA_TAILSCALE_IP=100.x.y.z

# Path to the Claude Code CLI (defaults to "claude" on your PATH).
CLAUDE_BIN=claude

# Extra args passed to Claude Code. To let it edit files unattended you'll
# typically want to bypass interactive permission prompts, e.g.:
#   CLAUDE_ARGS=--permission-mode acceptEdits
# or (broader, use with care):
#   CLAUDE_ARGS=--dangerously-skip-permissions
CLAUDE_ARGS=
