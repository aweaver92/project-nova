# Copy to .env and fill in. The bridge reads these at startup.

# Port the bridge listens on (default 8787).
PORT=8787

# Shared secret. MUST match the "Bridge token" you enter in the Nova app
# (Agents tab -> Claude - Nova Bridge). Use a long random string.
NOVA_BRIDGE_TOKEN=change-me-to-a-long-random-secret

# Cursor SDK API key (user key or team service-account key).
# From https://cursor.com/dashboard/integrations
CURSOR_API_KEY=cursor_...

# Default model for Cursor agents (see `Cursor.models.list()`).
CURSOR_MODEL=composer-2.5

# Default working directory for Claude Code / Cursor agents when the request
# doesn't specify one. Defaults to the directory you start the bridge from.
NOVA_BRIDGE_WORKDIR=

# Path to the Claude Code CLI (defaults to "claude" on your PATH).
CLAUDE_BIN=claude

# Extra args passed to Claude Code. To let it edit files unattended you'll
# typically want to bypass interactive permission prompts, e.g.:
#   CLAUDE_ARGS=--permission-mode acceptEdits
# or (broader, use with care):
#   CLAUDE_ARGS=--dangerously-skip-permissions
CLAUDE_ARGS=
