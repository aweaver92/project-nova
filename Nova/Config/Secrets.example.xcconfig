// Copy to Secrets.xcconfig (git-ignored) for local builds, OR set the
// GitHub Actions repo secret OPENAI_API_KEY so SideStore IPAs bake it in.
//
// Voice V2 (Settings → Voice chat beta) needs this key on-device.
// The main Assistant tab can still mint Realtime secrets via nova-bridge.
OPENAI_API_KEY = sk-your-key-here
