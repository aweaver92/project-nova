// Copy to Secrets.xcconfig (git-ignored) for local builds, OR set the
// GitHub Actions repo secret OPENAI_API_KEY so SideStore IPAs bake it in.
//
// Prefer unquoted values. If your key contains //, leave this empty — CI
// injects OpenAIAPIKey into Info.plist after the build instead.
// The app strips wrapping quotes at runtime if any leak through.
OPENAI_API_KEY = sk-your-key-here
