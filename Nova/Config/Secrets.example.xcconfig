// Copy this file to Config/Secrets.xcconfig (git-ignored) and set your key.
// Used only for private/personal device builds so DirectOpenAITokenService can
// mint ephemeral Realtime secrets. Do NOT commit your real key.
//
// Note: this bakes the standard key into the app bundle's Info.plist in plain
// text — acceptable for a private sideloaded build, not for distribution.
OPENAI_API_KEY = sk-your-standard-openai-key
